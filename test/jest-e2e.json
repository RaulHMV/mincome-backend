{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/support/setup-env.ts"],
  "testTimeout": 30000,
  "transformIgnorePatterns": [
    "/node_modules/",
    "/dist-lambda/",
    "/mincome-lambda-"
  ]
}
