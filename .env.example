# Copia este archivo a .env (Git lo ignora). Las llaves y contraseñas van
# vacías aquí; nunca subas un .env.

# --- Base de datos -----------------------------------------------------------
# Local: tu PostgreSQL 16. En AWS: el RDS Proxy, con DB_IAM_AUTH=true y sin
# contraseña (ver docs/despliegue.md).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mincome
DB_USER=mincome_app
DB_PASSWORD=
# TLS verificando el certificado. En Lambda está prendido por omisión.
DB_SSL=false
# Solo para conectarse directo a RDS (no por el proxy): el bundle de AWS.
DB_SSL_CA_FILE=
DB_IAM_AUTH=false
# En Lambda los valores por omisión cambian: pool de 2 sin mínimo, 1 reintento.
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY_MS=3000

# --- Autenticación (Cognito) ---------------------------------------------------
# jwt: la app verifica el token (local). api-gateway: lee los claims que ya
# validó API Gateway (por omisión en Lambda).
AUTH_MODE=jwt
COGNITO_USER_POOL_ID=
# Los app clients del front web y del móvil, separados por coma.
COGNITO_CLIENT_IDS=

CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# --- Rutas internas de mincome-ai-wrapper (/internal/*) -------------------------
# Local (AUTH_MODE=jwt): llave compartida de al menos 32 caracteres.
INTERNAL_API_KEY=
# AWS (AUTH_MODE=api-gateway): roles IAM que pueden firmar, separados por coma.
INTERNAL_CALLER_ROLE_ARNS=

# --- Idempotency-Key -----------------------------------------------------------
# Cifran las respuestas guardadas (traen datos financieros). Obligatorias con
# NODE_ENV=production. Una o varias de 32+ caracteres, la más nueva primero:
#   openssl rand -base64 48
IDEMPOTENCY_ENCRYPTION_KEYS=

# --- NestJS Observe (opcional) -------------------------------------------------
# Sin las dos, el agente queda apagado.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
